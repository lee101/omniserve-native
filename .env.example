# Required for requests arriving through Cloudflare Tunnel.
OMNISERVE_FRONTDOOR_TOKEN=replace-with-a-long-random-secret

# Optional local OpenAI-compatible inference server, for example llama.cpp.
OMNISERVE_LOCAL_UPSTREAM=http://host.docker.internal:8081/v1/chat/completions

# Optional remote OpenAI-compatible fallback. Leave blank to serve locally only.
OMNISERVE_REMOTE_UPSTREAM=
OMNISERVE_REMOTE_BEARER_TOKEN=

# Open after this many transport/5xx failures, then retry after cooldown.
OMNISERVE_CIRCUIT_FAILURES=3
OMNISERVE_CIRCUIT_COOLDOWN_SECONDS=30

# Created in the Cloudflare Zero Trust dashboard. Never commit its value.
CLOUDFLARE_TUNNEL_TOKEN=
