+    // Pieces of one fused weight (qkv split into q/k/v) share x: one GEMM through the stacked
+    // downs, then one through a block-diagonal up, so the diff comes out already concatenated.
+    // The scale lands on the rank-r up factor instead of the full output, and the linear's
+    // activation pre-scale is skipped: it guards q8_1 fp16 sums in MMQ, which SGEMM does not use.
+    static ggml_tensor* linear_pieces_forward(ggml_context* ctx, ggml_tensor* x, const std::vector<LinearPiece>& pieces) {
+        int64_t rank_total = 0;
+        for (const auto& piece : pieces) {
+            rank_total += piece.down->ne[1];
+        }
+        ggml_tensor* down = pieces[0].down;
+        ggml_tensor* up   = ggml_scale(ctx, pieces[0].up, pieces[0].scale);
+        if (pieces.size() > 1) {
+            int64_t offset = pieces[0].down->ne[1];
+            up             = ggml_pad_ext(ctx, up, 0, (int)(rank_total - offset), 0, 0, 0, 0, 0, 0);
+            for (size_t i = 1; i < pieces.size(); ++i) {
+                int64_t rank          = pieces[i].down->ne[1];
+                ggml_tensor* up_piece = ggml_scale(ctx, pieces[i].up, pieces[i].scale);
+                up_piece              = ggml_pad_ext(ctx, up_piece, (int)offset, (int)(rank_total - offset - rank), 0, 0, 0, 0, 0, 0);
+                down                  = ggml_concat(ctx, down, pieces[i].down, 1);
+                up                    = ggml_concat(ctx, up, up_piece, 1);
+                offset += rank;
+            }
+        }
+        ggml_tensor* lx = ggml_ext_linear(ctx, x, down, nullptr);
+        return ggml_ext_linear(ctx, lx, up, nullptr);
+    }
