[Unit]
Description=omniserve-native C gateway (port 8791)
# On a cold boot the CUDA driver stack is not ready when network.target is
# reached. Starting first made llama.cpp fall back to CPU silently, which
# serves at a fraction of GPU throughput while still reporting healthy.
After=network.target nvidia-persistenced.service omniserve.service
Wants=nvidia-persistenced.service omniserve.service

[Service]
Type=simple
User=administrator
WorkingDirectory=/nvme0n1-disk/code/omniserve-native
EnvironmentFile=-/etc/omniserve-h3.env
# Belt and braces: persistenced being up does not guarantee the device is
# enumerable yet. The gateway also refuses to start on CPU when GPU layers
# were requested, so Restart=always retries until the GPU appears.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do nvidia-smi -L | grep -q GPU && exit 0; sleep 2; done; echo "no GPU after 120s" >&2; exit 1'
Environment=OMNISERVE_NATIVE_BIND=127.0.0.1
Environment=OMNISERVE_NATIVE_PORT=8791
Environment=OMNISERVE_NATIVE_LLM_GGUF=/nvme0n1-disk/models/omniserve-native/gemma-roleplay-v2-q8_0.gguf
Environment=OMNISERVE_NATIVE_LLM_SWAP_DIR=/nvme0n1-disk/models/omniserve-native
# Keep Gemma on CPU in the shared image profile. Full GPU offload leaves less
# than the VAE decoder's scratch requirement once Z-Image and the search
# tenants are resident, causing generation to finish denoising and then return
# HTTP 500 during decode. Hybrid splits exceed this GGUF's split-input limit.
Environment=OMNISERVE_NATIVE_NGL=0
Environment=OMNISERVE_NATIVE_CTX=4096
# One context per admitted request. LLM_PERMITS below is 1, so a second
# context could never be scheduled while it cost a full KV + compute buffer
# (1.36 GiB measured) that the image lane needs to batch at all.
Environment=OMNISERVE_NATIVE_LLM_CONTEXTS=1
# Halves the per-context KV cache with no measured quality change; see
# performance/quality.md. Forces flash attention, which llama.cpp requires for
# a quantized V cache.
Environment=OMNISERVE_NATIVE_KV_TYPE=q8_0
# Let the gateway size prefill scratch from actual current free VRAM. This is
# 512/128 for the CPU/shared profile and narrows further when a GPU swap lands
# on a busy card, instead of reserving the Blackwell 4096/1024 buffer blindly.
Environment=OMNISERVE_NATIVE_BATCH=auto
Environment=OMNISERVE_NATIVE_UBATCH=auto
# VRAM broker. Co-tenants ask for headroom instead of each racing to read
# cudaMemGetInfo; the floor is what unbrokered scratch allocations (notably the
# search server's per-query score buffer) rely on always being there.
Environment=OMNISERVE_NATIVE_VRAM_BROKER=1
Environment=OMNISERVE_NATIVE_VRAM_KEEP_FREE_MB=1024
Environment=OMNISERVE_NATIVE_VRAM_LEASE_TTL_S=120
# Page-cache warming for the weights the broker may ask us to drop, so an
# unload/reload cycle costs seconds rather than a cold read of 8 GB.
Environment=OMNISERVE_NATIVE_RAM_PREFETCH_ENABLED=1
Environment=OMNISERVE_NATIVE_RAM_KEEP_FREE_PCT=5
# Standing remote endpoints, used when the local lane is saturated or the local
# backend fails before responding. Paid tier only unless _OVERFLOW_TIERS says
# otherwise. Deliberately unset: images2.netwrck.com serves the older Proteus
# API (/create_and_upload_image), not /v1/images/generations, so it needs a
# translating adapter before it can stand in for the local image lane.
# Environment=OMNISERVE_NATIVE_IMAGE_OVERFLOW_UPSTREAM=
# Environment=OMNISERVE_NATIVE_STT_OVERFLOW_UPSTREAM=
# Environment=OMNISERVE_NATIVE_OVERFLOW_TIERS=paid
# Embedded Z-Image-Turbo Q4 is the primary image path. Python :8100 stays as
# LoRA/catalog/worker fallback via IMAGE_WORKER_UPSTREAM; :8790 remains for
# control-plane image routes that are not yet native.
Environment=OMNISERVE_NATIVE_SD_DIFFUSION_MODEL=/nvme0n1-disk/models/omniserve-native/zimage-q4/z_image_turbo-Q4_K.gguf
Environment=OMNISERVE_NATIVE_SD_VAE=/nvme0n1-disk/models/omniserve-native/zimage-q4/split_files/vae/ae.safetensors
Environment=OMNISERVE_NATIVE_SD_LLM=/nvme0n1-disk/models/omniserve-native/zimage-q4/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
Environment=OMNISERVE_NATIVE_SD_STREAM_LAYERS=1
Environment=OMNISERVE_NATIVE_SD_MMAP=1
Environment=OMNISERVE_NATIVE_SD_EAGER_LOAD=0
# The search tenant starts after this service and keeps about 4 GiB resident.
# Budgeting the diffusion graph at 8 GiB left only ~55 MiB once all tenants
# were warm, so every image size failed before denoising. stable-diffusion.cpp
# only enables stream_layers when diffusion parameters live on CPU; without
# this backend assignment the previous stream flag was silently ignored.
Environment=OMNISERVE_NATIVE_SD_PARAMS_BACKEND=cpu
Environment=OMNISERVE_NATIVE_SD_MAX_VRAM=2
# The conditioner aborts when CUDA pressure prevents it from producing hidden
# states. Reject before entering the library so pressure remains a retryable
# request failure instead of restarting every route in this shared gateway.
Environment=OMNISERVE_NATIVE_SD_MIN_FREE_MB=4096
Environment=OMNISERVE_NATIVE_SD_ZERO_GUIDANCE=1.0
# A full-frame 1024px VAE decode exceeds the remaining CUDA headroom on this
# shared profile after denoising has completed. Use the decoder's overlapped
# latent tiling so requested 1024x1024 images do not fail at the final stage.
Environment=OMNISERVE_NATIVE_SD_VAE_TILING=1
Environment=OMNISERVE_NATIVE_SD_VAE_TILE_X=64
Environment=OMNISERVE_NATIVE_SD_VAE_TILE_Y=64
Environment=OMNISERVE_NATIVE_SD_TELEPORT_CACHE_SIZE=32
# Resume exact repeats at the final scheduled step. The RTX 5090 sweep kept
# pixels identical and improved the three-case median prime/replay ratio from
# 1.217x at step 4 to 1.491x at step 8 on the nine-step profile.
Environment=OMNISERVE_NATIVE_SD_TELEPORT_START_STEP=8
Environment=OMNISERVE_NATIVE_IMAGE_PREFER_EMBEDDED=1
# RA1 fal_zimage LoRAs resolve by basename under this cache-only directory.
Environment=OMNISERVE_NATIVE_LORA_DIR=/nvme0n1-disk/code/cutedsl-site/inference/.lora_cache
Environment=OMNISERVE_NATIVE_LORA_REGISTRY=/nvme0n1-disk/code/cutedsl-site/inference/lora_registry.json
Environment=OMNISERVE_NATIVE_NSFW_LORA_PATH=/vfast/data/code/loras/new/nsm_ZIT_000017532.safetensors
Environment=OMNISERVE_NATIVE_NSFW_LORA_SCALE=0.6
Environment=OMNISERVE_NATIVE_SD_IMAGE_FORMAT=webp
Environment=OMNISERVE_NATIVE_SD_MAX_BATCH=1
Environment=OMNISERVE_NATIVE_IMAGE_UPSTREAM=http://127.0.0.1:8790
Environment=OMNISERVE_NATIVE_IMAGE_WORKER_UPSTREAM=http://127.0.0.1:8100
# Cost-aware H3 front door. Optional credentials and Cog routing are loaded
# from /etc/omniserve-h3.env; leaving that file absent preserves legacy video.
# A RunPod adapter for SAM2 object selection and SDXL inpainting. Keep unset
# until the scale-to-zero image-editor pool is deployed.
# Environment=OMNISERVE_NATIVE_IMAGE_EDITOR_UPSTREAM=https://image-editor-adapter.example/v1
Environment=OMNISERVE_NATIVE_IMAGE_GENERATE_PATH=/v1/images/generations
Environment=OMNISERVE_NATIVE_BIREFNET_UPSTREAM=http://127.0.0.1:9094
# BiRefNet serializes the CUDA model call internally, while download,
# preprocessing, CUDA matte postprocessing, and WebP encoding overlap. A 5090
# production canary measured 2.98 img/s at one permit and 4.95 img/s at two;
# four permits reached 7.29 img/s but raised mean latency from 335 to 509 ms.
# Two is the throughput/latency knee and matches BIREFNET_JOB_WORKERS.
Environment=OMNISERVE_NATIVE_BIREFNET_PERMITS=2
Environment=OMNISERVE_NATIVE_TTS_UPSTREAM=http://127.0.0.1:9083
Environment=OMNISERVE_NATIVE_STT_UPSTREAM=http://127.0.0.1:9096
Environment=OMNISERVE_NATIVE_FORECAST_UPSTREAM=http://127.0.0.1:8101
Environment=OMNISERVE_NATIVE_FORECAST_MODEL=amazon/chronos-2
Environment=OMNISERVE_NATIVE_FORECAST_PERMITS=2
Environment=OMNISERVE_NATIVE_TRAINING_UPSTREAM=http://127.0.0.1:9098
Environment=OMNISERVE_NATIVE_TRAINING_PERMITS=8
Environment=OMNISERVE_NATIVE_TRAINING_SWAP_EMBEDDED_MODELS=1
Environment=OMNISERVE_NATIVE_EMBEDDING_UPSTREAM=http://127.0.0.1:9083
Environment=OMNISERVE_NATIVE_EMBEDDING_GGUF=/nvme0n1-disk/models/omniserve-native/gte-modernbert-base-q8_0.gguf
Environment=OMNISERVE_NATIVE_EMBEDDING_POOLING=cls
Environment=OMNISERVE_NATIVE_MULTIMODAL_UPSTREAM=http://127.0.0.1:9083
Environment=OMNISERVE_NATIVE_3D_UPSTREAM=http://127.0.0.1:9093
Environment=OMNISERVE_NATIVE_3D_MODEL=microsoft/TRELLIS.2-4B
Environment=OMNISERVE_NATIVE_3D_SWAP_EMBEDDED_MODELS=1
Environment=OMNISERVE_NATIVE_AUX_UPSTREAM=http://127.0.0.1:9083
Environment=OMNISERVE_NATIVE_CHAT_COMPAT_PROXY=1
Environment=OMNISERVE_NATIVE_MODELS_COMPAT_PROXY=1
Environment=OMNISERVE_NATIVE_SLOTS=8
Environment=OMNISERVE_NATIVE_LLM_PERMITS=1
# Embedded diffusion shares the 5090 with the LLM; keep image concurrency tight.
Environment=OMNISERVE_NATIVE_IMAGE_PERMITS=1
Environment=OMNISERVE_NATIVE_TTS_PERMITS=2
Environment=OMNISERVE_NATIVE_STT_PERMITS=2
Environment=OMNISERVE_NATIVE_EMBEDDING_PERMITS=1
Environment=OMNISERVE_NATIVE_MULTIMODAL_PERMITS=2
Environment=OMNISERVE_NATIVE_3D_PERMITS=8
Environment=OMNISERVE_NATIVE_AUX_PERMITS=1
ExecStart=/nvme0n1-disk/code/omniserve-native/build-full/omniserve-native --port 8791
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
